# Copy this file to .env and fill in your local values.
# The application loads these via python-dotenv in config.py.

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Ingestion
INGESTION_SOURCE=plaid
CSV_PATHS=data/transactions.csv

# Plaid API
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ACCESS_TOKENS=access-token-1,access-token-2
PLAID_BASE_URL=https://sandbox.plaid.com

# ML artifacts
MODEL_PATH=artifacts/classifier.joblib
LABELED_DATASET_PATH=labeled_transactions.csv

# Access control
ALLOWED_EMAILS=you@example.com,other@example.com
DASHBOARD_PASSWORD=change-me
