# Copy this file to .env and fill in your local values.
# The application loads these via python-dotenv in config.py.

# ── Required ────────────────────────────────────────────────────────────────
# Port 5433 (not 5432) to avoid clashing with a locally installed Postgres service.
# Use 127.0.0.1, NOT localhost: docker-compose binds the port on IPv4 only, but on
# Windows "localhost" resolves to ::1 first, so every connection stalls ~10-15s waiting
# for the IPv6 attempt to fail. Measured 0.1s vs 15.1s per connect — enough to make the
# seed script look like it has hung.
DATABASE_URL=postgresql://finance:finance@127.0.0.1:5433/finance

# ── Seed demo data (scripts/seed_sample_data.py) ────────────────────────────
# The seed script reads ONLY this var, never DATABASE_URL, so an accidental run can
# never write demo data into a production database. Point it at a disposable/local
# database — NEVER at a production DSN.
SEED_DATABASE_URL=postgresql://finance:finance@127.0.0.1:5433/finance

# ── Plaid (required to run the pipeline; NOT needed for the seed demo or dashboard) ──
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...
# PLAID_ACCESS_TOKENS=token1,token2
# PLAID_ACCESS_TOKEN_OWNERS=Alex,Sam
# PLAID_BASE_URL=https://sandbox.plaid.com

# ── Google OAuth (required for dashboard) ───────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI is where Google sends the browser back after consent. The correct
# value depends on WHICH frontend you are running, because the two have different callbacks and
# this single variable feeds both:
#   - React + api/ (current):  http://localhost:8000/auth/google/callback
#   - Streamlit app/ (legacy): http://localhost:8501/
# Point it at whichever one you're actually running; a stale value sends the browser to a dead
# port after sign-in (it just spins forever) and the real callback never runs, so no session
# cookie is ever minted and every /auth/me returns 401. Whatever you use here must ALSO be
# registered verbatim in the Google Cloud Console under Authorized redirect URIs, or Google
# rejects the request with redirect_uri_mismatch.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com

# ── React/API (used once api/ is live) ──────────────────────────────────────
# JWT_SECRET is required once api/ is deployed — it signs the session cookie's JWT.
# JWT_SECRET=...
# FRONTEND_ORIGIN is the CORS allow-list origin for the API (the React app's URL) and where
# the post-login redirect sends the browser. Must match the port Vite actually prints on
# startup (`npm run dev` in web/) -- if 5173 is already taken, Vite silently falls back to
# 5174/5175/etc, and a stale FRONTEND_ORIGIN here causes "localhost refused to connect" right
# after a successful Google sign-in. api/main.py reads this once at process startup (cached),
# so restart uvicorn after changing it.
FRONTEND_ORIGIN=http://localhost:5173

# ── Supabase (optional — only if using Supabase instead of docker) ──────────
# SUPABASE_URL=https://yourproject.supabase.co

# ── ML artifacts ────────────────────────────────
# MODEL_PATH=artifacts/classifier.joblib
# LABELED_DATASET_PATH=labeled_transactions.csv
