# Copy this file to .env and fill in your local values.
# The application loads these via python-dotenv in config.py.

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Ingestion
INGESTION_SOURCE=plaid
CSV_PATHS=data/transactions.csv

# Plaid API
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ACCESS_TOKENS=access-token-1,access-token-2
PLAID_ACCESS_TOKEN_OWNERS=Person1,Person2
PLAID_BASE_URL=https://sandbox.plaid.com
PLAID_LINK_CLIENT_NAME=Automated Financial Intelligence
PLAID_LINK_USER_ID=local-link-user
PLAID_LINK_PRODUCTS=transactions
PLAID_LINK_COUNTRY_CODES=US
PLAID_LINK_LANGUAGE=en
PLAID_LINK_WEBHOOK=
PLAID_LINK_REDIRECT_URI=http://localhost:8501/

# ML artifacts
MODEL_PATH=artifacts/classifier.joblib
LABELED_DATASET_PATH=labeled_transactions.csv

# Access control
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501/
GOOGLE_ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com
